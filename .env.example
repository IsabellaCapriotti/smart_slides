# Copy this file to `.env` and fill in ONE provider's key. Keys are read only by
# the backend (server/) and are never sent to or bundled into the browser.

# Which provider to use: gemini (default, has a free tier) | nanogpt | anthropic | openai-compatible
LLM_PROVIDER=gemini

# --- Gemini (free tier available): https://aistudio.google.com/apikey
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash

# --- NanoGPT (uses the subscription endpoint, so only subscription-included models are served)
# Run `npm run models` to list valid model ids.
# NANOGPT_API_KEY=
# NANOGPT_MODEL=

# --- Anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-5-5

# --- Any OpenAI-compatible endpoint (OpenRouter, Groq, Ollama, ...)
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_API_KEY=
# LLM_MODEL=

# Optional: backend port (default: 8787)
# PORT=8787
